# ---------------------------------------------------------------------------
# LEVY UI environment
# Copy to `.env` for local dev (git-ignored). Only the two URLs are required.
# NEVER put MongoDB Atlas URIs, model API keys, or any secret in this file —
# it is read by the browser build. Those belong to the agent service only.
# ---------------------------------------------------------------------------

# Server-side only: used by the route loader in src/lib/levy-source.server.ts
# to fetch GET {LEVY_API_URL}/v1/snapshot during SSR. Not exposed to the client.
LEVY_API_URL=http://localhost:8000

# Optional server-side bearer token for the agent service. Leave blank if the
# service is unauthenticated — Authorization is only sent when this is set.
LEVY_API_KEY=

# Public (browser-exposed) base URL for the live-refresh EventSource and
# client-side snapshot refetches. MUST be a plain URL — never a key.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_LEVY_API_URL=http://localhost:8000
