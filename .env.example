# LEVY environment configuration
# All secrets are read from the environment only. Never commit real values.

# --- Runtime mode ---
# When true, LEVY runs fully offline: in-memory persistence, deterministic
# classifiers/LLM/web adapters. No network or MongoDB required.
LEVY_OFFLINE=true

# --- MongoDB (production mode only; ignored when LEVY_OFFLINE=true) ---
LEVY_MONGO_URI=mongodb://localhost:27017
LEVY_MONGO_DB=levy

# --- OpenRouter (Jev + chat models) ---
LEVY_OPENROUTER_API_KEY=
LEVY_OPENROUTER_BASE_URL=https://openrouter.ai
LEVY_JEV_MODEL=typesafe/jev-1.13

# --- Web research providers ---
LEVY_FIRECRAWL_API_KEY=
LEVY_TAVILY_API_KEY=

# --- API server ---
LEVY_API_HOST=0.0.0.0
LEVY_API_PORT=8000
# Comma-separated list of allowed CORS origins
LEVY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Budgets ---
LEVY_DEFAULT_QUESTION_BUDGET_USD=5.0
LEVY_JEV_TIMEOUT_SECONDS=2.0

# --- Seed on startup ---
LEVY_SEED_ON_START=false
